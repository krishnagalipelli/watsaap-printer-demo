{
  "name": "baileys_service",
  "version": "1.0.0",
  "description": "WhatsApp Baileys integration for waprinter",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64 --output baileys-service.exe"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.0",
    "express": "^4.19.2",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "bin": "server.js",
  "pkg": {
    "scripts": "server.js",
    "targets": [
      "node18-win-x64"
    ]
  }
}
