.venv/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.spec
installer/Output/
*.egg-info/
node_modules/

# WhatsApp session credentials. Anyone holding these files can send messages as
# the linked account, so they must never reach the repository.
baileys_auth_info/
whatsapp_token.*
settings.json
# Carries the access token in plain text so one installer can configure a
# machine unattended. provision.example.json is the documented template and is
# safe; a filled-in provision.json is not.
provision.json

# Downloaded build artifacts and stray archives in the repo root.
*.zip
*.crdownload

# Loose sample documents dropped in the repo root. These are real client and
# third-party paperwork with names, phone numbers and account details on them.
/*.pdf

# macOS Finder metadata.
.DS_Store
